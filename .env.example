# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STAFF_ADMIN_PASSCODE: Optional server-side passcode for general Staff Portal access.
# If unset, staff accounts are managed via first-run setup and Executive Admin.
STAFF_ADMIN_PASSCODE=

# EXECUTIVE_ADMIN_PASSCODE: Optional server-side passcode for the Executive Admin Backend (/executive-admin).
# If unset, the CEO / primary authorized user claims and changes their own password inside /executive-admin.
EXECUTIVE_ADMIN_PASSCODE=
